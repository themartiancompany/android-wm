_bin="$(
  dirname \
    "$(command \
         -v \
         "env")")"
_lib="${_bin}/../lib"
_share="${_bin}/../share"
_crash_bash="${_lib}/libcrash-bash/crash-bash"
_sourced \
  "${_crash_bash}" \
  2>"/dev/null" \
  1>"/dev/null" || \
source \
  "${_crash_bash}"

_root_requirements() {
  _check_cmd \
    "awk" \
    "gawk"
  _check_cmd \
    "grep"
  _check_cmd \
    "sdk-version" \
    "android-utils"
  _check_cmd \
    "sed"
  _check_cmd \
    "su"
}

# shellcheck disable=SC2034
_global_variables() {
  get_date=""
  get_mode=""
  output_format=""
  color=""
  quiet=""
}

_root_get() {
  local \
    _dumpsys \
    _cmd \
    _msg=() \
    _sdk
  _sdk="$(
    sdk-version)"
  _msg=(
    "Detected SDK version '${_sdk}'."
  )
  _msg_info \
    "${_msg[*]}"
  if (( 32 < "${_sdk}" )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
    # _cmd=(
    #   "/system/bin/dumpsys"
    #     "activity"
    #     "activities"
    # )
  elif (( "${_sdk}" < 28 )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  else
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  fi
  _msg=(
    "Running '${_cmd[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _dumpsys="$(
    su \
      -c \
      "${_cmd[*]}" || \
      true)"
  if [[ "${_dumpsys}" == "" ]]; then
    _msg=(
      "Error running '${_cmd[*]}'."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
  "_dumpsys_${_output_format}_encode" \
    "${_dumpsys}"
}

_dumpsys_plain_encode() {
  local \
    _dumpsys="${1}"
  echo \
    "${_dumpsys}"
}

_window_json_get() {
  local \
    _msg=() \
    _jq_opts=() \
    _session_encode_opts=() \
    _window_encode_opts=()
  _jq_opts+=(
    -n
  )
  _session_encode_opts+=(
    --arg
      "id"
        "${_session_id}"
    --arg
      "unknown-session-id"
        "${_user_word}"
    --arg
      "app-user-id":
        "${_app_user_id}"
    --arg
      "app-user-name":
        "${_app_user_name}"
    '$ARGS.named'
  )
  _session="$(
    jq \
      "${_jq_opts[@]}" \
      "${_session_encode_opts[@]}")"
  _window_encode_opts+=(
      --arg
        "id"
          "${_id}"
      --arg
        "user-id"
          "${_user_id}"
      --arg
        "activity"
          "${_activity}"
      --arg
        "mDisplayId"
          "${_display_id}"
      --arg
        "rootId"
          "${_display_id}"
      --arg
        "mSession"
          "${_session}"
      '$ARGS.named'
  )
  _window="$(
    jq \
      "${_jq_opts[@]}" \
      "${_window_encode_opts[@]}")"
  _msg=(
    "Detected window ${_index},"
    "extracted:"
  )
  _msg_info \
    "${_msg[*]}"
  if [[ "${quiet}" == "n" ]]; then
    echo \
      "${_window}"
  fi
  _window=""
}

_dumpsys_json_encode() {
  local \
    _dumpsys="${1}" \
    _dumpsys_window_windows=() \
    _id \
    _activity \
    _activity_word \
    _app_user_id \
    _app_user_name \
    _index \
    _line=() \
    _line_string \
    _root_task_id \
    _root_task_id_word \
    _session_id \
    _session_id_word \
    _user_unknown_id \
    _user_word \
    _msg=() \
    _window
  _msg=(
    "Encoding dumpsys output"
    "in JSON format."
  )
  _msg_info \
    "${_msg[*]}"
  mapfile \
    -d \
      $'\n' \
    _dumpsys_window_windows < \
    <(echo \
        "${_dumpsys}")
  _msg=(
    "Dumpsys output is '${#_dumpsys_window_windows[@]}'"
    "lines long."
  )
  _msg_info \
    "${_msg[*]}"
  _index=-1
  _window=""
  for _line_string in "${_dumpsys_window_windows[@]}"; do
    _line=(
      ${_line_string}
    )
    if [[ "${_line_string}" == "  Window #"* ]]; then
      _msg=(
        "Parsing window line."
      )
      _msg_info \
        "${_msg[*]}"
      if [[ "${_window}" != "" ]]; then
        _window_json_get
      fi
      _index="$((
        _index + 1 ))"
      _id="$(
        echo \
          "${_line[2]}" |
            sed \
              's/Window{//g')"
      _user_id="${_line[3]}"
      _activity_word="${_line[4]}"
      _activity="${_activity_word%*\}:}"
    elif [[ "${_line_string}" == "mDisplayId="*"rootTaskId="*"mSession="*"mClient="* ]]; then
      _display_id_word="${_line[0]}"
      _display_id="${_display_id_word##mDisplayId=}"
      _root_task_id_word="${_line[1]}"
      _root_task_id="${_root_task_id_word##rootTaskId=}"
      _session_id_word="${_line[2]}"
      _session_id="${_display_id_word##mSession=Session\{}"
      _user_word="${_line[3]}"
      _session_unknown_id="${_user_word%%:*}"
      _user_unknown_id="${_user_word%%:*}"
      _app_user_id="${_user_word##*:${_user_id}}"
      _app_user_name="${_user_id}_a${_user_app_id#10}"
    else
      true
      # echo \
      #   "${_line}"
    fi
  done
  # echo \
  #   "${_window}"
}

_windows_info() {
  local \
    _mode="${1}" \
    _output_format="${2}" \
    _output_info \
    _cmd=() \
    _activities
  "_${_mode}_get"
}

_auto_detect_mode() {
  local \
    _os \
    _msg=()
  _os="$(
    uname \
      -o)"
  if [[ "${_os}" == "Android" ]]; then
    _root_requirements
    echo \
      "root"
  elif [[ "${_os}" == "GNU/Linux" ]]; then
    _msg=(
      "Not implemented."
      "Something with 'xdotool'"
      "needs to be written."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "get" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "output" \
    "format" \
    "json"
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "     Got activity at date:   ${get_date}"
  _msg_info "                 Get mode:   ${get_mode}"
  _msg_info "            Output format:   ${output_format}"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

Returns informations about currently opened windows.

Usage:

  ${app_name}
    [options]

  options:

     -o                   Output format.
                          It can be 'json' or 'plain'.
                          Default: ${output_format}

     -h                   This message.
     -c                   Enable color output.
     -v                   Enable verbose output

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${1}"
}

_globals
_global_variables
# shellcheck disable=SC2004
# shellcheck disable=SC2034
while \
  getopts \
    'm:o:cvh?' \
    arg; do
  case \
    "${arg}" in
    m)
      override_get_mode="${OPTARG}" ;;
    o)
      override_output_format="${OPTARG}" ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _set_overrides
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 \
  ))
_set_overrides
app_opts=(
  "${get_mode}"
  "${output_format}"
)
_show_config
_windows_info \
  "${app_opts[@]}"

