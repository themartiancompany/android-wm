_dumpsys_json_encode() {
  local \
    _dumpsys="${1}" \
    _dumpsys_window_windows=() \
    _id \
    _activity \
    _activity_word \
    _app_user \
    _app_user_id \
    _app_user_name \
    _app_op \
    _app_op_word \
    _base_layer \
    _base_layer_word \
    _client \
    _client_word \
    _fit_sides \
    _fit_sides_word \
    _fl \
    _fl_word \
    _flag \
    _flags=() \
    _frames_display \
    _frames_frame \
    _frames_insets_change \
    _frames_insets_changed \
    _frames_last \
    _frames_last_word \
    _frames_parent \
    _frames_surface \
    _frames_surface_word \
    _full_configuration_string \
    _given_content_insets \
    _given_content_insets_word \
    _given_visible_insets \
    _given_visible_insets_word \
    _have_frame \
    _have_frame_word \
    _index \
    _index_display \
    _last_reported_configuration_string \
    _layout \
    _layout_sequence_number_word \
    _layout_sequence_number \
    _line=() \
    _line_string \
    _owner_uid_word \
    _owner_uid \
    _package \
    _package_word \
    _pfl \
    _pfl_word \
    _position_layout_word \
    _position_layout \
    _position \
    _private_flags=() \
    _requested_width \
    _requested_width_word \
    _requested_height \
    _requested_height_word \
    _root_task_id \
    _root_task_id_word \
    _session_id \
    _session_id_word \
    _show_for_all_users \
    _show_for_all_users_word \
    _state_animator_id \
    _state_animator_id_word \
    _state_animator_owner \
    _state_animator_owner_word \
    _surface_id \
    _surface_name \
    _surface_name_word \
    _sub_layer \
    _sub_layer_word \
    _token_type \
    _uid \
    _user_id \
    _user_unknown_id \
    _user_word \
    _view_obscured \
    _view_obscured_word \
    _view_visibility \
    _view_visibility_word \
    _msg=() \
    _window \
    _window_grouping_token \
    _window_token_id \
    _window_token_id_word \
    _window_token_type
  _msg=(
    "Encoding dumpsys output"
    "in JSON format."
  )
  _msg_info \
    "${_msg[*]}"
  mapfile \
    -d \
      $'\n' \
    _dumpsys_window_windows < \
    <(echo \
        "${_dumpsys}")
  _msg=(
    "Dumpsys output is '${#_dumpsys_window_windows[@]}'"
    "lines long."
  )
  _msg_info \
    "${_msg[*]}"
  _index=-1
  _window=""
  for _line_string in "${_dumpsys_window_windows[@]}"; do
    _line=(
      ${_line_string}
    )
    if [[ "${_line_string}" == "  Window #"* ]]; then
      _index_display="$((
        _index + 1))"
      _msg=(
        "Parsing window '${_index_display}' line."
      )
      _msg_info \
        "${_msg[*]}"
      if (( -1 < "${_index}" )); then
        _window_json_get
      fi
      _index="$((
        _index + 1 ))"
      _id="$(
        echo \
          "${_line[2]}" |
            sed \
              's/Window{//g')"
      _user_id="${_line[3]}"
      _activity_word="${_line[4]}"
      _activity="${_activity_word%*\}:}"
      _values_clean
    elif [[ "${_line_string}" == "    mDisplayId="*" rootTaskId="*" mSession="*" mClient="* ]]; then
      _msg=(
        "Parsing display/session/client line."
      )
      _msg_info \
        "${_msg[*]}"
      _display_id_word="${_line[0]}"
      _display_id="${_display_id_word##mDisplayId=}"
      _root_task_id_word="${_line[1]}"
      _root_task_id="${_root_task_id_word##rootTaskId=}"
      _session_id_word="${_line[2]}"
      _session_id="${_session_id_word##mSession=Session\{}"
      _user_word="${_line[3]}"
      _session_unknown_id="${_user_word%%:*}"
      _user_unknown_id="${_user_word%%:*}"
      _app_user="${_user_word##*:}"
      _app_user_id="${_app_user##${_user_id}}"
      _app_user_id="${_app_user_id%\}}"
      _uid="${_app_user_id#a}"
      if [[ "${_app_user_id}" == "a"* ]]; then
        _app_user_name="${_user_id}_a${_uid#10}"
      else
        _app_user_name="$(
          id \
            -un \
            "${_uid}")"
      fi
      _client_word="${_line[4]}"
      _client="${_client_word#mClient=}"
    elif [[ "${_line_string}" == "    mOwnerUid="*" showForAllUsers="*" package="*" appop="* ]]; then
      _msg=(
        "Parsing owner-uid/visibility/package line."
      )
      _msg_info \
        "${_msg[*]}"
      _owner_uid_word="${_line[0]}"
      _owner_uid="${_owner_uid_word#mOwnerUid=}"
      _show_for_all_users_word="${_line[1]}"
      _show_for_all_users="${_show_for_all_users_word#showForAllUsers=}"
      _package_word="${_line[2]}"
      _package="${_package_word#package=}"
      _app_op_word="${_line[3]}"
      _app_op="${_app_op_word#appop=}"
    elif [[ "${_line_string}" == "    mAttrs={"* ]]; then
    # elif [[ "${_line_string}" == "    mAttrs={"*" sim="*"{"*"state="*" adjust="*" ty="*" fmt="*" wanim="*" sysuil="* ]]; then
      _msg=(
        "Parsing first attributes line."
      )
      _msg_info \
        "${_msg[*]}"
      _position_layout_word="${_line[0]}"
      _position_layout="${_position_layout_word#mAttrs=\{}"
      _position="${_position_layout%(*}"
      _layout="${_position_layout#*)}"
    elif [[ "${_line_string}" == "      fl="* ]]; then
      _fl_word="${_line[0]}"
      _fl="${_fl_word#fl=}"
      _flags+=(
        "\"${_fl}\""
      )
      for _flag in "${_line[@]:1}"; do
        _flags+=(
          "\"${_flag}\""
        )
      done
    elif [[ "${_line_string}" == "      pfl="* ]]; then
      _pfl_word="${_line[0]}"
      _pfl="${_pfl_word#pfl=}"
      _private_flags+=(
        "\"${_pfl}\""
      )
      for _flag in "${_line[@]:1}"; do
        _private_flags+=(
          "\"${_flag}\""
        )
      done
    elif [[ "${_line_string}" == "      bhv="* ]]; then
      _behavior_word="${_line[0]}"
      _behavior="${_behavior_word#bhv=}"
      _behavior="${_behavior#%\}}"
    elif [[ "${_line_string}" == "      fitSides="* ]]; then
      _fit_sides_word="${_line[0]}"
      _fit_sides="${_fit_sides_word#fitSides=}"
      _fit_sides="${_fit_sides%\}}"
    elif [[ "${_line_string}" == "    Requested"*" w="*" h="*" mLayoutSeq="* ]]; then
      _requested_width_word="${_line[1]}"
      _requested_width="${_requested_width_word#w=}"
      _requested_height_word="${_line[2]}"
      _requested_height="${_requested_height_word#h=}"
      _layout_sequence_number_word="${_line[3]}"
      _layout_sequence_number="${_layout_sequence_number_word#mLayoutSeq=}"
    elif [[ "${_line_string}" == "    mBaseLayer"*" mSubLayer="*" mToken="* ]]; then
      _base_layer_word="${_line[0]}"
      _base_layer="${_base_layer_word#mBaseLayer=}"
      _sub_layer_word="${_line[1]}"
      _sub_layer="${_sub_layer_word#mSubLayer=}"
      _window_token_id_word="${_line[2]}"
      _window_token_id="${_window_token_id_word#mToken=WindowToken\{}"
      if [[ "${_window_token_id_word}" == "${_window_token_id}" ]]; then
        _window_token_type="${_window_token_id_word#mToken=}"
        _window_token_type="${_window_token_type%\{}"
        _msg=(
          "Unknown token type '${_window_token_type}'"
          "at line '${_line_string}' in output"
          "of 'dumpsys window windows'."
        )
        _msg_error \
          "${_msg[*]}" \
          1
      fi
      for _word in "${_line[@]:3}"; do
        if [[ "${_word}" == "type="* ]]; then
          _token_type="${_word#type=}"
        elif [[ "${_word}" == "android.os.Binder@"* ]]; then
          _window_grouping_token="${_word%\}}"
        elif [[ "${_word}" == "android.os.BinderProxy@"* ]]; then
          _window_grouping_token="${_word%\}}"
        elif [[ "${_word}" == "android.view.ViewRootImpl\$W@"* ]]; then
          _window_grouping_token="${_word%\}}"
        else
          _msg=(
            "Unknown property '${_word}'"
            "for 'WindowToken' object."
          )
          _msg_error \
            "${_msg[*]}" \
            1
        fi
      done
    elif [[ "${_line_string}" == "    mViewVisibility="*" mHaveFrame="*" mObscured="* ]]; then
      _view_visibility_word="${_line[0]}"
      _view_visibility="${_view_visibility_word#mViewVisibility=}"
      _have_frame_word="${_line[1]}"
      _have_frame="${_have_frame_word#mHaveFrame=}"
      _view_obscured_word="${_line[2]}"
      _view_obscured="${_view_obscured_word#mObscured=}"
    elif [[ "${_line_string}" == "    mGivenContentInsets="*" mGivenVisibleInsets="* ]]; then
      _given_content_insets_word="${_line[0]}"
      _given_content_insets="${_given_content_insets_word#mGivenContentInsets=}"
      _given_visible_insets_word="${_line[1]}"
      _given_visible_insets="${_given_visible_insets_word#mGivenVisibleInsets=}"
    elif [[ "${_line_string}" == "    mFullConfiguration="* ]]; then
      _full_configuration_string="${_line_string#    mFullConfiguration=\{}"
      _full_configuration_string="${_full_configuration_string%\}}"
      _full_configuration_string_parse \
        "${_full_configuration_string}"
    elif [[ "${_line_string}" == "    mLastReportedConfiguration="* ]]; then
      _last_reported_configuration_string="${_line_string#    mLastReportedConfiguration=\{}"
      _last_reported_configuration_string="${_last_reported_configuration_string%\}}"
      _full_configuration_string_parse \
        "${_last_reported_configuration_string}"
    elif [[ "${_line_string}" == "    mHasSurface="*" isReadyForDisplay()="*" mWindowRemovalAllowed="* ]]; then
      _has_surface_word="${_line[0]}"
      _has_surface="${_has_surface_word#mHasSurface=}"
      _is_ready_for_display_word="${_line[1]}"
      _is_ready_for_display="${_is_ready_for_display_word#mHasSurface=}"
      _window_removal_allowed_word="${_line[2]}"
      _window_removal_allowed="${_window_removal_allowed_word#mWindowRemovalAllowed=}"
    elif [[ "${_line_string}" == "    Frames: "* ]]; then
      for _word in "${_line[@]}"; do
        if [[ "${_word}" == "parent="* ]]; then
          _frames_parent="${_word#parent=}"
        elif [[ "${_word}" == "display="* ]]; then
          _frames_display="${_word#display=}"
        elif [[ "${_word}" == "frame="* ]]; then
          _frames_frame="${_word#frame=}"
        elif [[ "${_word}" == "last="* ]]; then
          _frames_last="${_word#last=}"
        elif [[ "${_word}" == "insetsChange="* ]]; then
          _frames_insets_change="${_word#insetsChange=}"
        elif [[ "${_word}" == "insetsChanged="* ]]; then
          _frames_insets_changed="${_word#insetsChanged=}"
        fi
      done
insetsChanged=false
    elif [[ "${_line_string}" == "      surface="* ]]; then
      _frames_surface_word="${_line[0]}"
      _frames_surface="${_frames_surface_word#surface=}"
    elif [[ "${_line_string}" == "    WindowStateAnimator={"* ]]; then
      _state_animator_id_word="${_line[0]}"
      _state_animator_id="${_state_animator_id_word#WindowStateAnimator\{}"
      _state_animator_owner_word="${_line[1]}"
      _state_animator_owner="${_state_animator_owner_word%\}:}"
    elif [[ "${_line_string}" == "      mSurface=Surface("* ]]; then
      _surface_name_word="${_line[0]}"
      _surface_name="${_surface_name_word#mSurface=Surface\(name=}"
      _surface_name="${_surface_name%\)*}"
      _surface_id="${_surface_name_word##*\/}"
    else
      true
      # echo \
      #   "${_line}"
    fi
  done
  # echo \
  #   "${_window}"
}

