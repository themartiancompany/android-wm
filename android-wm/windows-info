_bin="$(
  dirname \
    "$(command \
         -v \
         "env")")"
_lib="${_bin}/../lib"
_share="${_bin}/../share"
_crash_bash="${_lib}/libcrash-bash/crash-bash"
_sourced \
  "${_crash_bash}" \
  2>"/dev/null" \
  1>"/dev/null" || \
source \
  "${_crash_bash}"

_root_requirements() {
  _check_cmd \
    "awk" \
    "gawk"
  _check_cmd \
    "grep"
  _check_cmd \
    "sdk-version" \
    "android-utils"
  _check_cmd \
    "sed"
  _check_cmd \
    "su"
}

# shellcheck disable=SC2034
_global_variables() {
  get_date=""
  get_mode=""
  output_format=""
  color=""
  quiet=""
}

_root_get() {
  local \
    _dumpsys \
    _cmd \
    _msg=() \
    _sdk
  _sdk="$(
    sdk-version)"
  _msg=(
    "Detected SDK version '${_sdk}'."
  )
  _msg_info \
    "${_msg[*]}"
  if (( 32 < "${_sdk}" )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
    # _cmd=(
    #   "/system/bin/dumpsys"
    #     "activity"
    #     "activities"
    # )
  elif (( "${_sdk}" < 28 )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  else
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  fi
  _msg=(
    "Running '${_cmd[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _dumpsys="$(
    su \
      -c \
      "${_cmd[*]}" || \
      true)"
  if [[ "${_dumpsys}" == "" ]]; then
    _msg=(
      "Error running '${_cmd[*]}'."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
  "_dumpsys_${_output_format}_encode" \
    "${_dumpsys}"
}

_dumpsys_plain_encode() {
  local \
    _dumpsys="${1}"
  echo \
    "${_dumpsys}"
}

_window_json_get() {
  local \
    _msg=() \
    _jq_opts=() \
    _attrs \
    _attrs_encode_opts=() \
    _session \
    _session_encode_opts=() \
    _window_encode_opts=() \
    _msg=()
  _msg=(
    "Encoding window object JSON."
  )
  _msg_info \
    "${_msg[*]}"
  _jq_opts+=(
    -n
  )
  _session_encode_opts+=(
    --arg
      "id"
        "${_session_id}"
    --arg
      "unknown-session-id"
        "${_user_word}"
    --arg
      "app-uid":
        "${_uid}"
    --arg
      "app-user-name":
        "${_app_user_name}"
    --arg
      "mClient":
        "${_client}"
    '$ARGS.named'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_session_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _session="$(
    jq \
      "${_jq_opts[@]}" \
      "${_session_encode_opts[@]}")"
  _attrs_encode_opts+=(
    --arg
      "position-layout"
        "${_position_layout}"
    --arg
      "position"
        "${_position}"
    --arg
      "layout"
        "${_user_word}"
    --arg
      "app-uid":
        "${_uid}"
    --arg
      "app-user-name":
        "${_app_user_name}"
    --arg
      "mClient":
        "${_client}"
    '$ARGS.named'
  )
  _attrs="$(
    jq \
      "${_jq_opts[@]}" \
      "${_attrs_encode_opts[@]}")"
  _window_encode_opts+=(
      --arg
        "id"
          "${_id}"
      --arg
        "user-id"
          "${_user_id}"
      --arg
        "activity"
          "${_activity}"
      --arg
        "mDisplayId"
          "${_display_id}"
      --arg
        "rootId"
          "${_display_id}"
      --argjson
        "mAttrs"
          "${_session}"
      --argjson
        "mSession"
          "${_session}"
      --arg
        "mOwnerUid"
          "${_owner_uid}"
      --arg
        "showForAllUsers"
          "true"
      --arg
        "package"
          "${_package}"
      --arg
        "appop"
          "${_app_op}"
      '$ARGS.named'
  )
  _window="$(
    jq \
      "${_jq_opts[@]}" \
      "${_window_encode_opts[@]}")"
  _msg=(
    "Detected window ${_index},"
    "extracted:"
  )
  _msg_info \
    "${_msg[*]}"
  if [[ "${quiet}" == "n" ]]; then
    echo \
      "${_window}"
  fi
  _window=""
}

_dumpsys_json_encode() {
  local \
    _dumpsys="${1}" \
    _dumpsys_window_windows=() \
    _id \
    _activity \
    _activity_word \
    _app_user \
    _app_user_id \
    _app_user_name \
    _app_op \
    _app_op_word \
    _client \
    _client_word \
    _index \
    _layout \
    _line=() \
    _line_string \
    _owner_uid_word \
    _owner_uid \
    _package \
    _package_word \
    _position_layout_word \
    _position_layout \
    _position \
    _root_task_id \
    _root_task_id_word \
    _session_id \
    _session_id_word \
    _show_for_all_users \
    _show_for_all_users_word \
    _uid \
    _user_id \
    _user_unknown_id \
    _user_word \
    _msg=() \
    _window
  _msg=(
    "Encoding dumpsys output"
    "in JSON format."
  )
  _msg_info \
    "${_msg[*]}"
  mapfile \
    -d \
      $'\n' \
    _dumpsys_window_windows < \
    <(echo \
        "${_dumpsys}")
  _msg=(
    "Dumpsys output is '${#_dumpsys_window_windows[@]}'"
    "lines long."
  )
  _msg_info \
    "${_msg[*]}"
  _index=-1
  _window=""
  for _line_string in "${_dumpsys_window_windows[@]}"; do
    _line=(
      ${_line_string}
    )
    if [[ "${_line_string}" == "  Window #"* ]]; then
      _msg=(
        "Parsing window line."
      )
      _msg_info \
        "${_msg[*]}"
      if (( 1 < "${_index}" )); then
        _window_json_get
      fi
      _index="$((
        _index + 1 ))"
      _id="$(
        echo \
          "${_line[2]}" |
            sed \
              's/Window{//g')"
      _user_id="${_line[3]}"
      _activity_word="${_line[4]}"
      _activity="${_activity_word%*\}:}"
    elif [[ "${_line_string}" == "    mDisplayId="*" rootTaskId="*" mSession="*" mClient="* ]]; then
      _msg=(
        "Parsing display/session/client line."
      )
      _msg_info \
        "${_msg[*]}"
      _display_id_word="${_line[0]}"
      _display_id="${_display_id_word##mDisplayId=}"
      _root_task_id_word="${_line[1]}"
      _root_task_id="${_root_task_id_word##rootTaskId=}"
      _session_id_word="${_line[2]}"
      _session_id="${_session_id_word##mSession=Session\{}"
      _user_word="${_line[3]}"
      _session_unknown_id="${_user_word%%:*}"
      _user_unknown_id="${_user_word%%:*}"
      _app_user="${_user_word##*:}"
      _app_user_id="${_app_user##${_user_id}}"
      _app_user_id="${_app_user_id%\}}"
      _uid="${_app_user_id#a}"
      if [[ "${_app_user_id}" == "a"* ]]; then
        _app_user_name="${_user_id}_a${_uid#10}"
      else
        _app_user_name="$(
          id \
            -un \
            "${_uid}")"
      fi
      _client_word="${_line[4]}"
      _client="${_client_word#mClient=}"
    elif [[ "${_line_string}" == "    mOwnerUid="*" showForAllUsers="*" package="*" appop="* ]]; then
      _msg=(
        "Parsing owner-uid/visibility/package line."
      )
      _msg_info \
        "${_msg[*]}"
      _owner_uid_word="${_line[0]}"
      _owner_uid="${_owner_uid_word#mOwnerUid=}"
      _show_for_all_users_word="${_line[1]}"
      _show_for_all_users="${_show_for_all_users_word#showForAllUsers=}"
      _package_word="${_line[2]}"
      _package="${_package_word#package=}"
      _app_op_word="${_line[3]}"
      _app_op="${_app_op_word#appop=}"
    elif [[ "${_line_string}" == "    mAttrs={"*" sim={state="*" adjust="*" ty="*" fmt="*" wanim="*" sysuil="* ]]; then
      _msg=(
        "Parsing first attributes line."
      )
      _msg_info \
        "${_msg[*]}"
      _position_layout_word="${_line[0]}"
      _position_layout="${_position_layout_word#mAttrs=\{}"
      _position="${_position_layout%(*}"
      _layout="${_position_layout#*)}"
    # mAttrs={(0,0)(fillxfill) sim={state=always_hidden adjust=resize} ty=BASE_APPLICATION fmt=TRANSPARENT wanim=0x10302fd sysuil=true
    #   fl=LAYOUT_IN_SCREEN LAYOUT_INSET_DECOR SHOW_WALLPAPER SPLIT_TOUCH HARDWARE_ACCELERATED DRAWS_SYSTEM_BAR_BACKGROUNDS
    #   pfl=NO_MOVE_ANIMATION FORCE_DRAW_STATUS_BAR_BACKGROUND USE_BLAST FIT_INSETS_CONTROLLED
    #   bhv=DEFAULT
    #   fitSides=}

    else
      true
      # echo \
      #   "${_line}"
    fi
  done
  # echo \
  #   "${_window}"
}

_windows_info() {
  local \
    _mode="${1}" \
    _output_format="${2}" \
    _output_info \
    _cmd=() \
    _activities
  "_${_mode}_get"
}

_auto_detect_mode() {
  local \
    _os \
    _msg=()
  _os="$(
    uname \
      -o)"
  if [[ "${_os}" == "Android" ]]; then
    _root_requirements
    echo \
      "root"
  elif [[ "${_os}" == "GNU/Linux" ]]; then
    _msg=(
      "Not implemented."
      "Something with 'xdotool'"
      "needs to be written."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "get" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "output" \
    "format" \
    "json"
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "     Got activity at date:   ${get_date}"
  _msg_info "                 Get mode:   ${get_mode}"
  _msg_info "            Output format:   ${output_format}"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

Returns informations about currently opened windows.

Usage:

  ${app_name}
    [options]

  options:

     -o                   Output format.
                          It can be 'json' or 'plain'.
                          Default: ${output_format}

     -h                   This message.
     -c                   Enable color output.
     -v                   Enable verbose output

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${1}"
}

_globals
_global_variables
# shellcheck disable=SC2004
# shellcheck disable=SC2034
while \
  getopts \
    'm:o:cvh?' \
    arg; do
  case \
    "${arg}" in
    m)
      override_get_mode="${OPTARG}" ;;
    o)
      override_output_format="${OPTARG}" ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _set_overrides
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 \
  ))
_set_overrides
app_opts=(
  "${get_mode}"
  "${output_format}"
)
_show_config
_windows_info \
  "${app_opts[@]}"

