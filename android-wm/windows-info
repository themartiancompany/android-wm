}

_root_get() {
  local \
    _dumpsys \
    _cmd \
    _msg=() \
    _sdk
  _sdk="$(
    sdk-version)"
  _msg=(
    "Detected SDK version '${_sdk}'."
  )
  _msg_info \
    "${_msg[*]}"
  if (( 32 < "${_sdk}" )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
    # _cmd=(
    #   "/system/bin/dumpsys"
    #     "activity"
    #     "activities"
    # )
  elif (( "${_sdk}" < 28 )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  else
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  fi
  _msg=(
    "Running '${_cmd[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _dumpsys="$(
    su \
      -c \
      "${_cmd[*]}" || \
      true)"
  if [[ "${_dumpsys}" == "" ]]; then
    _msg=(
      "Error running '${_cmd[*]}'."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
  "_dumpsys_${_output_format}_encode" \
    "${_dumpsys}"
}

_dumpsys_plain_encode() {
  local \
    _dumpsys="${1}"
  echo \
    "${_dumpsys}"
}

_window_json_get() {
  local \
    _msg=() \
    _jq_opts=() \
    _attrs \
    _attrs_encode_opts=() \
    _flags_jq_arg \
    _flags_json \
    _flags_encode_opts=() \
    _msurface \
    _msurface_ecode_opts=() \
    _private_flags_jq_arg \
    _private_flags_json \
    _private_flags_encode_opts=() \
    _session \
    _session_encode_opts=() \
    _state_animator \
    _state_animator_encode_opts=() \
    _token \
    _token_encode_opts=() \
    _window_encode_opts=() \
    _msg=()
  _msurface=""
  _msg=(
    "Encoding window object JSON."
  )
  _msg_info \
    "${_msg[*]}"
  _jq_opts+=(
    -n
  )
  _msg=(
    "Getting session JSON."
  )
  _msg_info \
    "${_msg[*]}"
  _session_encode_opts+=(
    --arg
      "id"
        "${_session_id}"
    --arg
      "unknown-session-id"
        "${_user_word}"
    --arg
      "app-uid":
        "${_uid}"
    --arg
      "app-user-name":
        "${_app_user_name}"
    --arg
      "mClient":
        "${_client}"
    '$ARGS.named'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_session_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _session="$(
    jq \
      "${_jq_opts[@]}" \
      "${_session_encode_opts[@]}")"
  _msg=(
    "Getting flags JSON."
  )
  _msg_info \
    "${_msg[*]}"
  _flags_jq_arg="[$(
    IFS=","; \
    echo \
      "${_flags[*]}")]"
  _flags_encode_opts+=(
    --argjson
      "flags"
        "${_flags_jq_arg}"
    '$ARGS.named.flags'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_flags_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _flags_json="$(
    jq \
      "${_jq_opts[@]}" \
      "${_flags_encode_opts[@]}")"
  _msg=(
    "Flags JSON: ${_flags_json}"
  )
  _msg_info \
    "${_msg[*]}"
  _msg=(
    "Getting private flags JSON."
  )
  _msg_info \
    "${_msg[*]}"
  _private_flags_jq_arg="[$(
    IFS=","; \
    echo \
      "${_private_flags[*]}")]"
  _private_flags_encode_opts+=(
    --argjson
      "pflags"
        "${_private_flags_jq_arg}"
    '$ARGS.named.pflags'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_private_flags_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _private_flags_json="$(
    jq \
      "${_jq_opts[@]}" \
      "${_private_flags_encode_opts[@]}")"
  _msg=(
    "Private flags JSON: ${_private_flags_json}"
  )
  _msg_info \
    "${_msg[*]}"
  _attrs_encode_opts+=(
    --arg
      "position-layout"
        "${_position_layout}"
    --arg
      "position"
        "${_position}"
    --arg
      "layout"
        "${_layout}"
    --argjson
      "fl"
        "${_flags_json}"
    --argjson
      "pfl"
        "${_private_flags_json}"
    --arg
      "bhv"
        "${_behavior}"
    --arg
      "fitSides"
        "${_fit_sides}"
    '$ARGS.named'
  )
  _attrs="$(
    jq \
      "${_jq_opts[@]}" \
      "${_attrs_encode_opts[@]}")"
  _token_encode_opts+=(
    --arg
      "id"
        "${_window_token_id}"
    --arg
      "type"
        "${_token_type}"
    --arg
      "window-grouping-token"
        "${_window_grouping_token}"
    '$ARGS.named'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_token_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _token="$(
    jq \
      "${_jq_opts[@]}" \
      "${_token_encode_opts[@]}")"
  _msg=(
    "Window token JSON: ${_token}"
  )
  _msg_info \
    "${_msg[*]}"
  _frames_encode_opts+=(
    --arg
      "display"
        "${_frames_display}"
    --arg
      "frame"
        "${_frames_frame}"
    --arg
      "last"
        "${_frames_last}"
    --arg
      "surface"
        "${_frames_surface}"
  )
  if [[ "${_frames_insets_change}" != "" ]]; then
    _frames_encode_opts+=(
      --arg
        "insetsChange"
          "${_frames_insets_change}"
    )
  fi
  if [[ "${_frames_insets_changed}" != "" ]]; then
    _frames_encode_opts+=(
      --arg
        "insetsChanged"
          "${_frames_insets_changed}"
    )
  fi
  _frames_encode_opts+=(
    '$ARGS.named'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_frames_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _frames="$(
    jq \
      "${_jq_opts[@]}" \
      "${_frames_encode_opts[@]}")"
  _msg=(
    "Window frames JSON: ${_frames}"
  )
  _msg_info \
    "${_msg[*]}"
  if [[ "${_surface_id}" != "" ]]; then
    _msurface_encode_opts+=(
      --arg
        "name"
          "${_surface_name}"
      --arg
        "id"
          "${_surface_id}"
      '$ARGS.named'
    )
    _msg=(
      "Running jq with options"
      "'${_jq_opts[*]}"
      "${_msurface_encode_opts[*]}'."
    )
    _msg_info \
      "${_msg[*]}"
    _msurface="$(
      jq \
        "${_jq_opts[@]}" \
        "${_msurface_encode_opts[@]}")"
    _msg=(
      "Window frames JSON: ${_msurface}"
    )
    _msg_info \
      "${_msg[*]}"
  fi
  _state_animator_encode_opts+=(
    --arg
      "id"
        "${_state_animator_id}"
    --arg
      "owner"
        "${_state_animator_owner}"
  )
  if [[ "${_msurface}" != "" ]]; then
    _state_animator_encode_opts+=(
      --argjson
        "mSurface"
          "${_msurface}"
    )
  fi
  _state_animator_encode_opts+=(
    '$ARGS.named'
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts[*]}"
    "${_state_animator_encode_opts[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _state_animator="$(
    jq \
      "${_jq_opts[@]}" \
      "${_state_animator_encode_opts[@]}")"
  _msg=(
    "Window State Animator JSON: ${_state_animator}"
  )
  _msg_info \
    "${_msg[*]}"
  _window_encode_opts+=(
      --arg
        "id"
          "${_id}"
      --arg
        "user-id"
          "${_user_id}"
      --arg
        "activity"
          "${_activity}"
      --arg
        "mDisplayId"
          "${_display_id}"
      --arg
        "rootId"
          "${_display_id}"
      --argjson
        "mAttrs"
          "${_attrs}"
      --argjson
        "mSession"
          "${_session}"
      --argjson
        "mToken"
          "${_token}"
      --arg
        "mOwnerUid"
          "${_owner_uid}"
      --arg
        "showForAllUsers"
          "true"
      --arg
        "package"
          "${_package}"
      --arg
        "appop"
          "${_app_op}"
      --arg
        "w"
          "${_requested_width}"
      --arg
        "h"
          "${_requested_height}"
      --arg
        "mLayoutSeq"
          "${_layout_sequence_number}"
      --arg
        "mBaseLayer"
          "${_base_layer}"
      --arg
        "mSubLayer"
          "${_sub_layer}"
      --arg
        "mViewVisibility"
          "${_view_visibility}"
      --arg
        "mHaveFrame"
          "${_have_frame}"
      --arg
        "mObscured"
          "${_view_obscured}"
      --arg
        "mGivenContentInsets"
          "${_given_content_insets}"
      --arg
        "mGivenVisibleInsets"
          "${_given_visible_insets}"
      --arg
        "mFullConfiguration"
          "${_full_configuration_string}"
      --arg
        "mLastReportedConfiguration"
          "${_last_reported_configuration_string}"
      --argjson
        "Frames"
          "${_frames}"
      --argjson
        "WindowStateAnimator"
          "${_state_animator}"
      '$ARGS.named'
  )
  _window="$(
    jq \
      "${_jq_opts[@]}" \
      "${_window_encode_opts[@]}")"
  _msg=(
    "Detected window ${_index},"
    "extracted:"
  )
  _msg_info \
    "${_msg[*]}"
  if [[ "${quiet}" == "n" ]]; then
    echo \
      "${_window}"
  fi
  _window=""
}

